# ============================================================
#  Novel OS 2 - copy to .env and fill in what you use.
#
#  Connections added in the studio (Settings > Connections)
#  take precedence over everything here, and can be set per
#  role or per agent. Keys here are the fallback; with no
#  connection, the provider is auto-detected from which key is
#  set, or forced with NOVEL_OS_LLM_PROVIDER.
#  OLLAMA_API_KEY is imported as the default Ollama Cloud
#  connection on first start.
# ============================================================

# --- Server -------------------------------------------------
# NOVEL_OS_DATA_DIR=./data                      # SQLite DB + media live here
# NOVEL_OS_DATABASE_URL=                        # default: sqlite:///<DATA_DIR>/novel_os.db
# NOVEL_OS_DATABASE_URL=postgresql+psycopg://novel:novel@localhost:5432/novel_os   # pip install "psycopg[binary]"
# NOVEL_OS_CORS_ORIGINS=http://localhost:3000   # comma-separated; the launcher adds its own web port
# NOVEL_OS_API_URL=http://127.0.0.1:8000        # where the studio (Next) proxies /api
# NOVEL_OS_MODEL=                               # default model id for the env provider
# NOVEL_OS_MAX_TOKENS=
# NOVEL_OS_NO_EMBED=1                           # disable embeddings for memory recall
# NOVEL_OS_EMBED_MODEL=

# --- Ollama Cloud (recommended default) ---------------------
# OLLAMA_API_KEY=...                            # https://ollama.com/settings/keys
# NOVEL_OS_MODEL=gpt-oss:120b

# --- Ollama on your machine (free, private) -----------------
# NOVEL_OS_LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# NOVEL_OS_MODEL=qwen3:32b

# --- Anthropic (Claude) -------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# NOVEL_OS_MODEL=claude-sonnet-4-6

# --- AWS Bedrock (pip install "anthropic[bedrock]") ---------
# Uses the standard AWS credential chain (env, ~/.aws profile, SSO).
# NOVEL_OS_LLM_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...                         # if using temporary credentials
# AWS_PROFILE=default
# AWS_REGION=us-east-1

# --- OpenAI -------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# --- Azure OpenAI -------------------------------------------
# NOVEL_OS_LLM_PROVIDER=azure
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# NOVEL_OS_MODEL=your-deployment-name

# --- Google Gemini (text, and Nano Banana images) -----------
# GEMINI_API_KEY=...                            # GOOGLE_API_KEY also works

# --- Other hosted providers (set the key; pick with NOVEL_OS_LLM_PROVIDER) ---
# OPENROUTER_API_KEY=...     # openrouter
# GROQ_API_KEY=...           # groq
# TOGETHER_API_KEY=...       # together
# DEEPSEEK_API_KEY=...       # deepseek
# MISTRAL_API_KEY=...        # mistral
# FIREWORKS_API_KEY=...      # fireworks
# NVIDIA_API_KEY=...         # nvidia
# XAI_API_KEY=...            # xai
# PERPLEXITY_API_KEY=...     # perplexity
# KIMI_API_KEY=...           # kimi   (KIMI_BASE_URL=https://api.moonshot.cn/v1 from China)

# --- LM Studio / vLLM / any OpenAI-compatible endpoint ------
# NOVEL_OS_LLM_PROVIDER=openai_compatible       # or lmstudio
# NOVEL_OS_BASE_URL=https://your-endpoint/v1
# NOVEL_OS_API_KEY=...

# --- Image services (cover studio, media) -------------------
# Add these in Settings > Connections; the key formats are:
#   Gemini (Nano Banana)      your GEMINI_API_KEY
#   OpenAI Images             your OPENAI_API_KEY
#   Runway                    API key from https://dev.runwayml.com
#   Higgsfield                KEY_ID:KEY_SECRET from https://cloud.higgsfield.ai
#   Google Flow (useapi.net)  a useapi.net API token. UNOFFICIAL: it drives your own
#                             Flow account with your Google AI plan's credits.

# --- Research swarm -----------------------------------------
# TAVILY_API_KEY=...
# BRAVE_API_KEY=...
# NOVEL_OS_RESEARCH_BROWSER=0                   # disable headless Chromium even if installed

# --- MCP server (Claude Code / Desktop / Cursor / Codex) ----
#   claude mcp add novel-os -- python -m novel_os mcp
#   python -m novel_os mcp --http --port 8765   -> http://127.0.0.1:8765/mcp

# Studio access: unset = this computer only. Set to sign in from other devices.
NOVEL_OS_PASSWORD=
# NOVEL_OS_LOCAL_ONLY=0  # trust every client (private network only)
